# Copy to .env and fill in. Nothing here has a safe default: the app refuses to
# start without FLASK_SECRET_KEY and JWT_SECRET unless DEBUG is on.

# Signs the Flask session cookie.  openssl rand -base64 32
FLASK_SECRET_KEY=

# Signs the API JWTs issued by /auth/token.  openssl rand -base64 32
JWT_SECRET=

# Off unless explicitly enabled. Recognized truthy values: 1 true yes on
DEBUG=False

# Send the session cookie only over HTTPS. Defaults to the opposite of DEBUG;
# set to False only if terminating TLS somewhere this app cannot see.
# SESSION_COOKIE_SECURE=True

# Idle lifetime of an admin session.
# SESSION_LIFETIME_MINUTES=480

# Comma-separated origins allowed to make credentialed cross-origin calls.
# Leave empty to disallow all of them. "*" is rejected.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local dev server bind address for `python app.py`. Production uses uvicorn.
# DEV_BIND_HOST=127.0.0.1
# PORT=8000

# --- OAuth2 sign-in providers (optional) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=
